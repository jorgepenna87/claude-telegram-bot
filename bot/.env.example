# Copie este arquivo pra .env (mesma pasta) e preencha. NÃO comite o .env.

# === Telegram ===
# Token do bot que você criou no @BotFather no Telegram.
# (Passo a passo no README.md, seção "Passo 3 — Criar o bot no Telegram")
TELEGRAM_BOT_TOKEN=

# IDs do Telegram autorizados a usar o bot. Separados por vírgula.
# Você descobre teu user_id mandando "/whoami" pro bot uma vez (ele responde
# "Você não está autorizado. Seu user_id: 12345678" — pegue esse número).
# Pode adicionar amigos/família depois, separando por vírgula.
ALLOWED_USER_IDS=

# === Bot ===
# Nome que aparece na boas-vindas. Coloque o nome do seu agente.
BOT_NAME=Assistente

# Pasta onde o `claude -p` vai rodar. Por padrão, é a pasta-mãe do bot/.
# É a pasta-raiz onde mora teu CLAUDE.md com a personalidade.
# Pode deixar comentado pra usar o default.
# CLAUDE_WORK_DIR=C:\Users\seuuser\claude-telegram-bot

# Timeout em segundos pra cada chamada do claude (default 600 = 10min)
# CLAUDE_TIMEOUT_SECONDS=600

# === Transcrição de áudio (opcional, mas recomendado) ===
# API Groq pra rodar Whisper (transcrever áudios do Telegram).
# Gratuito até 14.400 minutos/mês. Pegue uma chave em console.groq.com/keys
# Se deixar vazio, o bot só aceita texto/arquivos, não áudio.
GROQ_API_KEY=

# Idioma do Whisper. "pt" pra português, "en" pra inglês, etc.
WHISPER_LANG=pt
